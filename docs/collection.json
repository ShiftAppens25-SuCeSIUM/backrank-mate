{
    "info": {
      "name": "FactCheck API",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
      "_postman_id": "e42e1dbb-68e5-4c11-9f12-df601a550b7a"
    },
    "item": [
      {
        "name": "Check Link",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"query\": \"https://www.youtube.com/shorts/abc123xyz\"\n}"
          },
          "url": {
            "raw": "http://localhost:8000/fact_check/link",
            "protocol": "http",
            "host": ["localhost"],
            "port": "8000",
            "path": ["fact_check", "link"]
          }
        }
      },
      {
        "name": "Check Text",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"query\": \"COVID-19 vaccines cause infertility.\"\n}"
          },
          "url": {
            "raw": "http://localhost:8000/fact_check/text",
            "protocol": "http",
            "host": ["localhost"],
            "port": "8000",
            "path": ["fact_check", "text"]
          }
        }
      },
      {
        "name": "Check File",
        "request": {
          "method": "POST",
          "header": [],
          "body": {
            "mode": "formdata",
            "formdata": [
              {
                "key": "query",
                "value": "This PDF claims the earth is flat.",
                "type": "text"
              },
              {
                "key": "files",
                "type": "file",
                "src": "/absolute/path/to/sample.pdf"
              }
            ]
          },
          "url": {
            "raw": "http://localhost:8000/fact_check/file",
            "protocol": "http",
            "host": ["localhost"],
            "port": "8000",
            "path": ["fact_check", "file"]
          }
        }
      }
    ]
  }
  